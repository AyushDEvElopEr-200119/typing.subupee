# --- Sign-in (required in production) ---
# A long random string. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# The public address of the site, e.g. https://typing.subupee.com (on Vercel this
# defaults to the project's production domain if left unset).
BETTER_AUTH_URL=http://localhost:3000
# Optional: extra comma-separated addresses allowed to sign in, e.g. a custom domain.
TRUSTED_ORIGINS=

# --- Database (required on Vercel) ---
# Hosted Turso database. Leave empty locally to use the data/subupee.db file.
# Create one at https://turso.tech, then copy the URL and an auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional social sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
